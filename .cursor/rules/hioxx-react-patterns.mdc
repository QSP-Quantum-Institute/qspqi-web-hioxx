  const [hasInteracted, setHasInteracted] = useState(false);

  // Validate on change after first interaction
  useEffect(() => { /* validate + updateData */ }, [localValue, hasInteracted]);

  return (
    <div className="w-full">
      <StepTitle color="gold">Pregunta?</StepTitle>
      {/* input */}
      {errors.field && hasInteracted && <motion.p>{errors.field}</motion.p>}
